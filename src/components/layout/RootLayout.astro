---
import "@/global.css";
// ship FontAwesome's CSS with the page; its default runtime injection makes icons flash unstyled until an island hydrates
import "@fortawesome/fontawesome-svg-core/styles.css";
import Head from "@/components/layout/Head.astro";
---

<script is:inline>
	// the CSS is imported above, so stop FontAwesome from also injecting it at runtime
	window.FontAwesomeConfig = { autoAddCss: false };

	const getThemePreference = () => {
		// if there is a saved preference, and it isn't "system", return the saved preference
		const savedTheme = localStorage.getItem("theme");
		if (savedTheme && savedTheme !== "system") {
			return savedTheme;
		}

		// otherwise use the system preference
		return window.matchMedia("(prefers-color-scheme: dark)").matches
			? "dark"
			: "light";
	};

	const applyTheme = () => {
		const theme = getThemePreference();

		const isDark = theme === "dark";

		document.documentElement.classList[isDark ? "add" : "remove"]("dark");
	};

	applyTheme();

	document.addEventListener("astro:after-swap", applyTheme);
</script>

<html lang="en">
	<Head />
	<body>
		<slot />
	</body>
</html>
