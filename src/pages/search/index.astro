---
import Layout from "@/components/layout/Layout.astro";
import { Page } from "@/pages/search/_index";
import { rpc } from "@/rpc/client";

export const prerender = false;

// a leading "!" asks for the top result itself rather than the results page, the way
// "\" does on duckduckgo. mostly for searches typed into the browser's address bar
const input = Astro.url.searchParams.get("q")?.trim() ?? "";
const launch = input.startsWith("!");
const query = (launch ? input.slice(1) : input).trim();

// there's nothing to show without a query, and the homepage is where a search starts
if (!query) return Astro.redirect("/");

// search items don't cover news, so the latest matching posts come from the news query
// alongside them
const [results, news] = await Promise.all([
	rpc.search.query({ q: query }),
	rpc.news.posts.query({
		filter: { keyword: query },
		paginate: { maxPageSize: 5 },
	}),
]);

// with no match to launch, fall through to the results page, which says so. only
// search results launch: a news post isn't what a "!" search is looking for
const [topResult] = results;
if (launch && topResult) return Astro.redirect(topResult.url);
---

<Layout title="Search">
	<Page
		query={query}
		results={results}
		news={news.posts}
		newsTotal={news.pagination.totalItems}
		origin={Astro.url.origin}
	/>
</Layout>
