---
import Layout from "@/components/layout/Layout.astro";

import { defaultVisibleFeeds } from "@/lib/news/feeds/config";

import { queryPosts } from "@/lib/news/query/query";

import { Page } from "@/pages/_index";

export const prerender = false;

const latestPosts = await queryPosts({
	feeds: defaultVisibleFeeds,
	filter: {},
	sort: {
		mode: "date",
		direction: "desc",
	},
	paginate: {
		page: 1,
		maxPageSize: 3,
	},
});
---

<Layout title="Home">
	<Page
		latestPosts={latestPosts}
		feedCount={defaultVisibleFeeds.length}
		postCount={latestPosts.pagination.totalItems}
		client:load
	/>
</Layout>
