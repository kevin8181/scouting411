---
import Layout from "@/components/layout/Layout.astro";
import { faSquareUpRight } from "@fortawesome/free-solid-svg-icons";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { defaultVisibleFeeds } from "@/lib/news/feeds/feedManager";

import { queryPosts } from "@/lib/news/query/query";

const latestPosts = await queryPosts({
	feeds: defaultVisibleFeeds,
	filter: {},
	sort: {
		mode: "date",
		direction: "desc",
	},
	paginate: {
		page: 1,
		maxPageSize: 3,
	},
});

const quickLinks = [
	{ href: "https://my.scouting.org", label: "my.Scouting" },
	{ href: "https://advancements.scouting.org", label: "Scoutbook Plus" },
	{ href: "https://scoutbook.scouting.org", label: "Scoutbook" },
	{ href: "https://status.scouting.org", label: "System Status" },
];
---

<Layout title="Home">
	<div
		class="flex h-full w-full flex-col items-center justify-center gap-10 p-8"
	>
		<div class="flex flex-col items-center gap-4">
			<h1 class="text-primary font-display text-5xl font-extrabold">
				Scouting411
			</h1>
			<h2 class="text-secondary-foreground text-xl">
				the unofficial front page of Scouting America
			</h2>
		</div>

		<div class="grid w-full max-w-5xl grid-cols-1 gap-5 sm:grid-cols-3">
			<div class="flex flex-col items-start gap-4 rounded-lg border p-6">
				<a
					href="/news/browse"
					class="text-primary font-serif text-xl font-bold hover:underline"
				>
					News
				</a>

				<ul class="flex w-full flex-col gap-2">
					{
						latestPosts.items.map((post) => (
							<li>
								<a
									href={post.url}
									rel="noopener noreferrer"
									target="_blank"
									class="text-primary line-clamp-2 text-sm font-medium wrap-anywhere hyphens-auto hover:underline"
								>
									{post.title}
								</a>
							</li>
						))
					}
				</ul>
				<a
					href="/news/browse"
					class="text-primary mt-auto text-xs font-medium hover:underline"
				>
					View all news &rarr;
				</a>
			</div>
			<div class="flex flex-col items-start gap-4 rounded-lg border p-6">
				<a
					href="/resources"
					class="text-primary font-serif text-xl font-bold hover:underline"
				>
					Resources
				</a>
				<div class="flex flex-wrap gap-2"></div>
				<a
					href="/resources"
					class="text-primary mt-auto text-xs font-medium hover:underline"
				>
					View all resources &rarr;
				</a>
			</div>
			<div class="flex flex-col items-start gap-4 rounded-lg border p-6">
				<span class="text-primary font-serif text-xl font-bold"
					>Quick Links</span
				>
				<ul class="flex w-full flex-col gap-2 text-sm">
					{
						quickLinks.map((link) => (
							<li>
								<a
									href={link.href}
									rel="noopener noreferrer"
									target="_blank"
									class="hover:border-primary hover:text-primary flex items-center justify-between gap-2 rounded-md border px-3 py-2 font-medium transition-colors"
								>
									{link.label}
									<FontAwesomeIcon icon={faSquareUpRight} height="1em" />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div
				class="flex flex-col items-start gap-4 rounded-lg border p-6 sm:col-span-3"
			>
				<span class="text-primary font-serif text-xl font-bold"
					>Stay in the Loop</span
				>
				<p class="text-sm">
					Get new posts via RSS or Atom &mdash; plug the feeds into your
					favorite reader.
				</p>
				<a
					href="/news/subscribe"
					class="bg-primary hover:bg-primary/90 text-primary-foreground mt-3 rounded-md px-4 py-2 text-sm font-semibold"
				>
					Subscribe
				</a>
			</div>
		</div>
	</div>
</Layout>
