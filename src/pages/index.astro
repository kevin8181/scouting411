---
import Layout from "@/components/layout/Layout.astro";

import { defaultVisibleFeeds } from "@/lib/news/feeds/feedManager";

import { queryPosts } from "@/lib/news/query/query";

import { Page } from "@/pages/_index";

const latestPosts = await queryPosts({
	feeds: defaultVisibleFeeds,
	filter: {},
	sort: {
		mode: "date",
		direction: "desc",
	},
	paginate: {
		page: 1,
		maxPageSize: 3,
	},
});
---

<Layout title="Home">
	<Page latestPosts={latestPosts} />
</Layout>
