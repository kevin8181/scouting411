---
import Layout from "@/components/layout/Layout.astro";
import { getFeedBySlug, isFeedSlug } from "@/lib/news/feeds/feedManager";
import { queryPosts } from "@/lib/news/query/query";

export const prerender = false;

const { slug } = Astro.params;

if (!slug || !isFeedSlug(slug)) {
	throw new Response("Not found", { status: 404 });
}

const feed = getFeedBySlug(slug);
const { posts } = await queryPosts({
	feeds: [slug],
	filter: {},
	sort: {
		direction: "desc",
		mode: "date",
	},
	paginate: {
		// todo we need a way to disable pagination
		maxPageSize: 999999,
		page: 1,
	},
});
---

<Layout title={"Feed: " + feed.name}>
	<div class="p-8">
		<p>{feed.description}</p>
		<p>
			Homepage: <a
				href={feed.urls.homepage}
				rel="noopener noreferrer"
				target="_blank"
				class="text-primary underline">{feed.urls.homepage}</a
			>
		</p>
		<p>Indexed posts: {posts.length}</p>
		<p>
			Subcribe:
			<ul>
				<li>
					<a href={feed.urls.rss} class="text-primary underline">rss</a>
				</li>
				<li>
					<a href={feed.urls.atom} class="text-primary underline">atom</a>
				</li>
			</ul>
		</p>
		<!-- todo add a link to browse just this feed -->
	</div>
</Layout>
